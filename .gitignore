# Auto-generated by Next on every invocation, and not the same on each:
# `next dev` writes .next/dev/types/..., `next build` writes .next/types/...
# Tracking it means the file flips back and forth with whichever command ran
# last. The file says so itself: "This file should not be edited".
src/web/next-env.d.ts
# ruflo swarm memory
.swarm
skills/swarm/

# Tool state some plugins drop into whatever directory a shell was in.
src/**/.claude/
