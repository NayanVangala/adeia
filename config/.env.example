# Adeia environment. Copy to the repo root as `.env` and fill in.
#   cp config/.env.example .env
#
# There is no payment-processor configuration here. No processor is attached —
# payments are authorised, recorded, and stop where settlement would begin. The
# server says so on every boot. See docs/payments.md.

# --- Phase 1: core infra ----------------------------------------------------
NODE_ENV=development
PORT=3000
ADEIA_DB_PATH=./adeia.db

# --- Phase 5: approvals -----------------------------------------------------
# REQUIRED to run the server from Phase 5 onward. Without somewhere to send
# approval requests, over-limit actions pause correctly and then wait forever
# because nobody is ever told — indistinguishable from a hung agent.
RESEND_API_KEY=re_...
# Must be a sender Resend has verified for your domain. Verification is not
# instant; do it well before you need to demo.
APPROVAL_FROM_EMAIL=approvals@yourdomain.com
# Where approval requests land. One approver per deployment in the MVP.
APPROVER_EMAIL=you@example.com
# Must be publicly reachable — a localhost link is useless on the phone the
# approver is holding. In development use a tunnel:
#   ngrok http 3000
# The URL changes on every ngrok restart. Re-set this and restart the server,
# or emailed links point at a dead host. This is the single most likely
# live-demo failure.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
# Optional. Defaults to 24h.
# APPROVAL_TOKEN_TTL_MS=86400000

# --- Phase 7: demo agent ----------------------------------------------------
# Demo agent only. The server never calls a model.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Client side (printed by `npm run seed`) --------------------------------
# ADEIA_API_KEY=adeia_sk_...
# ADEIA_URL=http://localhost:3000
