# Adeia environment. Copy to the repo root as `.env` and fill in per phase.
#   cp config/.env.example .env
#
# Phases 1-3 run fully offline. Nothing below Phase 4 needs a third-party account.

# --- Phase 1: core infra ----------------------------------------------------
NODE_ENV=development
PORT=3000
ADEIA_DB_PATH=./adeia.db

# --- Phase 4: payments ------------------------------------------------------
# Must start with sk_test_. The server refuses to boot on a live key.
# STRIPE_SECRET_KEY=sk_test_...

# --- Phase 5: approvals -----------------------------------------------------
# RESEND_API_KEY=re_...
# APPROVAL_FROM_EMAIL=approvals@yourdomain.com   # must be a Resend-verified sender
# APPROVER_EMAIL=you@example.com                 # where approval requests land
# PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app   # must be publicly reachable
# APPROVAL_TOKEN_TTL_MS=86400000                 # 24h

# --- Phase 7: demo agent ----------------------------------------------------
# Demo agent only. The server never calls a model.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Client side (printed by `npm run seed`) --------------------------------
# ADEIA_API_KEY=adeia_sk_...
# ADEIA_URL=http://localhost:3000
