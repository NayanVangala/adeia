# Adeia environment. Copy to the repo root as `.env` and fill in.
#   cp config/.env.example .env
#
# There is no payment-processor configuration here. No processor is attached —
# payments are authorised, recorded, and stop where settlement would begin. The
# server says so on every boot. See docs/payments.md.

# --- Phase 1: core infra ----------------------------------------------------
NODE_ENV=development
PORT=3000
ADEIA_DB_PATH=./adeia.db

# --- the database in production ---------------------------------------------
# Unset, the server uses ADEIA_DB_PATH above and nothing here is needed — so
# `npm run dev` and the tests want no account.
#
# Set both and it talks to Turso instead, which is what a deployment has to do:
# nothing free gives a server a persistent disk, and a container filesystem is
# discarded between requests. libSQL is a fork of SQLite, so the schema and
# every migration in src/backend/drizzle carry over untouched.
#
# Half-configured is refused rather than quietly falling back to the local
# disk — a server that believes it is writing to Turso and is not looks exactly
# like one that works, right up until somebody goes looking for the audit trail.
#
#   turso db create adeia
#   turso db show adeia --url
#   turso db tokens create adeia
#
# Apply migrations before the deploy that needs them: npm run db:migrate
# TURSO_DATABASE_URL=libsql://adeia-<org>.turso.io
# TURSO_AUTH_TOKEN=

# --- rate limit -------------------------------------------------------------
# Actions one project may create per minute. 0 disables it. Default 120.
#
# The policy engine bounds what an agent may spend in a day; this bounds how
# fast it can get there, and how quickly one project can fill an audit trail
# every later query has to read past. 120 is high enough that no honest agent
# notices — an agent making two requests a second, sustained, is not working.
# ADEIA_ACTIONS_PER_MINUTE=120

# --- Phase 5: approvals -----------------------------------------------------
# REQUIRED. Without somewhere to send approval requests, over-limit actions
# pause correctly and then wait forever because nobody is ever told —
# indistinguishable from a hung agent. The server refuses to start.
#
# Pick ONE transport. Setting only half of the SMTP pair is an error, not a
# fallback: the channel a human is watching must not change because of a typo.

# --- Transport A: SMTP (no account gate, works with any mailbox) ---
# For Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# SMTP_PASSWORD is that 16-character app password — never your account password.
# Host and port default to Gmail; 465 is implicit TLS, 587 is STARTTLS.
SMTP_USER=you@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Transport B: Resend (needs an account and a verified sender domain) ---
# Verification is not instant; do it well before you need to demo.
# RESEND_API_KEY=re_...

# The From address. On Gmail SMTP this must be the SMTP_USER mailbox or one of
# its verified aliases — Gmail rewrites anything else.
APPROVAL_FROM_EMAIL=you@gmail.com
# Where approval requests land. One approver per deployment in the MVP.
APPROVER_EMAIL=you@example.com
# Must be publicly reachable — a localhost link is useless on the phone the
# approver is holding. In development use a tunnel:
#   ngrok http 3000
# The URL changes on every ngrok restart. Re-set this and restart the server,
# or emailed links point at a dead host. This is the single most likely
# live-demo failure.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
# Optional. Defaults to 24h.
# APPROVAL_TOKEN_TTL_MS=86400000

# --- Phase 7: demo agent ----------------------------------------------------
# Demo agent only. The server never calls a model.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Client side (printed by `npm run seed`) --------------------------------
# ADEIA_API_KEY=adeia_sk_...
# ADEIA_URL=http://localhost:3000
